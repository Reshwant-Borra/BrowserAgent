# GBNF grammar for the action-specific BrowserAction JSON contract.
#
# The grammar is deliberately ordered to make constrained decoding practical for
# llama.cpp. The Python parser accepts normal JSON object ordering and performs the
# same action-specific validation for both llama.cpp and Ollama outputs.

root ::= open-url | click | type | select | scroll | back | extract | download | wait | finish

open-url ::= "{" ws "\"action\"" ws ":" ws "\"open_url\"" ws "," ws "\"url\"" ws ":" ws string ws "}"
click ::= "{" ws "\"action\"" ws ":" ws "\"click\"" ws "," ws "\"target\"" ws ":" ws integer ws "}"
type ::= "{" ws "\"action\"" ws ":" ws "\"type\"" ws "," ws "\"target\"" ws ":" ws integer ws "," ws "\"text\"" ws ":" ws string ws "}"
select ::= "{" ws "\"action\"" ws ":" ws "\"select\"" ws "," ws "\"target\"" ws ":" ws integer ws "," ws "\"value\"" ws ":" ws string ws "}"
scroll ::= "{" ws "\"action\"" ws ":" ws "\"scroll\"" (ws "," ws "\"direction\"" ws ":" ws direction)? ws "}"
back ::= "{" ws "\"action\"" ws ":" ws "\"back\"" ws "}"
extract ::= "{" ws "\"action\"" ws ":" ws "\"extract\"" (ws "," ws "\"target\"" ws ":" ws (integer | "null"))? ws "}"
download ::= "{" ws "\"action\"" ws ":" ws "\"download\"" ws "," ws "\"target\"" ws ":" ws integer ws "}"
wait ::= "{" ws "\"action\"" ws ":" ws "\"wait\"" wait-field? ws "}"
finish ::= "{" ws "\"action\"" ws ":" ws "\"finish\"" ws "," ws "\"result\"" ws ":" ws string ws "}"

wait-field ::= ws "," ws (wait-for-text | wait-url | wait-ms)
wait-for-text ::= "\"for_text\"" ws ":" ws string
wait-url ::= "\"url_contains\"" ws ":" ws string
wait-ms ::= "\"ms\"" ws ":" ws integer

direction ::= "\"up\"" | "\"down\""

integer ::= "0" | [1-9] [0-9]*
string ::= "\"" ( [^"\\] | "\\" ["\\/bfnrt] )* "\""
ws ::= [ \t\n]*
